__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.privacyPolicy=void 0;e.privacyPolicy={title:'Privacy  Policy',sections:[{title:'Who we are?',blocks:[{text:"CTI collectively referred to as 'we our' or 'us' is committed to safeguarding the security of your personal data and respecting the privacy of users (you or your) accessing our websites and related applications (collectively the Platform)"}]},{title:'What is this privacy notice for?',blocks:[{text:'We may handle your personal data in connection with your use of the Platform. This privacy notice (together with our Terms and Conditions) sets out our collection and sharing practices, the uses to which personal data is put, the ways in which we protect it in accordance with the data protection laws and your privacy rights.'},{text:'This Statement applies where you:'},{list:['Visit our website or mobile platforms.','Use our internet-based offerings and services.','Communicate with us via email, phone, or social media']}]},{title:'Data we collect',blocks:[{text:'We collect information directly from you (via forms or services you access) and indirectly via your use of the services.'},{text:'Directly collected information:'},{list:['Name, Contact details, Email ID.','IMEI and Device details for repair services.','Communications with our personnel.','Feedback and survey responses.']},{text:'Automatically collected information:'},{list:['IP addresses, Device details, and browser types.']}]},{title:'Use of Personal Data',blocks:[{text:'We use your Personal Data for the following purposes'},{list:[{bold:'Administering Services:',text:'To manage, promote, and improve our Platform.'},{bold:'User Registration:',text:'To administer your account and verify your identity.'},{bold:'Support Requests:',text:'To fulfill your queries and communicate with you.'},{bold:'Security:',text:'To protect the safety and security of our users and systems.'},{bold:'Marketing:',text:'To send updates and promotional material (with your consent).'}]}]},{title:'Disclosure of your Information',blocks:[{text:'We may share Personal Data with contracted service providers (hosting, payment processing, analytics) only as necessary to provide services. We may also share data in the event of a merger or acquisition, or when required by law to respond to legal requests.'}]},{title:'Your Right',blocks:[{list:['Right to access your personal data held by us.','Right to rectify inaccurate information.','Right to erase data (under certain conditions)','Right to restrict or object to processing.','Right to withdraw consent at any time.']}]},{title:'Security',blocks:[{text:'We use industry-standard encryption (SSL) and physical/electronic safeguards to protect your data. While we work dedicatedly to protect your Information, no system is 100% impenetrable.'}]},{title:'Cookies & Tracking Technologies',blocks:[{text:'We use cookies, web beacons, local storage and similar technologies to enhance your experience, remember preferences, analyze traffic and serve personalized content. Cookies help us deliver features like keeping you signed in, storing language preferences and measuring campaign performance.'},{list:[{bold:'Essential cookies:',text:'required for the site to operate correctly.'},{bold:'Analytics cookies:',text:'help us understand usage and improve the site.'},{bold:'Marketing cookies:',text:'used to deliver relevant ads and offers.'}]}]},{title:'Data Retention',blocks:[{text:'We retain personal data only as long as necessary to provide services, comply with legal obligations, resolve disputes, and enforce our agreements. Retention periods vary by data type and processing purpose.'},{list:[{bold:'Account data:',text:'retained while your account is active and for a period thereafter to comply with legal obligations.'},{bold:'Support and transactional records:',text:'retained for business and tax reasons (commonly 3-7 years depending on jurisdiction).'},{bold:'Marketing preferences:',text:'retained until you opt out or withdraw consent.'}]}]},{title:'Children and Minors',blocks:[{text:'Our Platform is intended for adult users and business customers. We do not knowingly collect personal data from children under the age of 13 (or age of majority in your jurisdiction). If you believe a child has provided us with personal data, contact us and we will take steps to remove it.'}]},{title:'Changes to this Policy',blocks:[{text:"We may update this Privacy Policy to reflect changes to our practices, legal requirements, or business operations. When we make material changes, we will provide notice on the Platform and update the 'Last Updated' date at the top of this page."},{text:'We encourage you to review this policy periodically to stay informed about our privacy practices.'}]},{title:'Warranty & Repair  Important Notes',blocks:[{text:'How can I claim my warranty?'},{text:'To claim your warranty, contact our support team via email or visit an authorized service centre. Provide your order ID or proof of purchase and the device for inspection. Our technicians will evaluate the issue and advise whether the repair or replacement is covered under warranty.'},{text:'To claim your warranty, you need to:'},{list:['Original proof of purchase or order ID.','Device serial number / IMEI and model details.','Clear photos or a short description of the issue','Device available for physical inspection (remove cases/accessories).','Claim submitted within the applicable warranty period.']},{text:'The warranty is not applicable under the following scenarios :'},{list:['Physical damage (cracks, dents) caused by drops or impacts.','Water or liquid ingress and corrosion damage.','Unauthorized repairs, modifications or third-party parts.','Tampered, removed or altered serial/ warranty labels and seals.','Cosmetic damage that does not affect device functionality','Software issues caused by third-party apps, rooting or OS changes.','Consumable parts (e.g., batteries) beyond their expected lifespan unless explicitly covered.']},{text:'Our warranty also does not cover the outcome of a repair if certain pre-repair conditions exist, including:'},{list:['Pre-existing internal corrosion or residue from prior liquid exposure.','evidence that previous third-party repairs have altered the fault.','Missing components, connectors or screws prior to arriving for repair.','Severe deformation, burns or other damage that prevents a safe repair.','Use of incompatible or non-standard replacement parts.']},{text:'Please note:'},{list:['Always back up your data before submitting a device for repair; we are not responsible for data loss.','Warranty remedies may include repair, replacement or refund at our discretion and in accordance with your purchase terms.','Warranty periods and specific exclusions are defined in your purchase documentation.','If a warranty claim is declined, we will provide the reason and available next steps.']}]}],footer:{title:'Questions?',text:'If you have any questions about this Privacy Policy, please contact us at ',link:'privacy@cti.com'}}},1442,[]);
