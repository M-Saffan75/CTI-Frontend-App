tPhoto,gallery:[r(d[0]).demoProductPhoto,r(d[0]).demoProductPhoto],sku:'REF-HUA-552-WT',totalVariants:1,condition:'Refurbished',grade:'Good',specs:{buildAndMaterials:'Stainless steel frame with durable fluoroelastomer strap.',displayAndVisuals:'1.43-inch AMOLED high-contrast touch screen with sapphire glass.',performance:'TruSeen 5.0+ heart rate monitoring and dual-band GPS.',cameraSystem:'Remote camera shutter trigger for paired mobile device.',batteryAndConnectivity:'14-day battery life on typical use with wireless magnetic charging.'}},{id:'ref-6',name:'Sony PlayStation 5 & Essentials Bundle',brand:'Sony',category:'Gaming Console',price:495,originalPrice:550,discountPercent:12,rating:5,reviewsCount:65,inStockCount:14,isVerified:!0,tag:'Refurbished',saveAmount:427,subtitle:'Experience crystal-clear sound and immersive next-gen gaming...',description:'Certified refurbished gaming console bundle with DualSense wireless controller, ultra-high speed SSD, and 4K ray tracing.',image:r(d[0]).demoProductPhoto,gallery:[r(d[0]).demoProductPhoto,r(d[0]).demoProductPhoto],sku:'REF-SNY-702-PS',totalVariants:1,condition:'Refurbished',grade:'Superb',specs:{buildAndMaterials:'Custom architectural casing with dynamic liquid metal cooling.',displayAndVisuals:'Up to 120fps with 120Hz output, 4K-TV gaming and 8K support.',performance:'Custom 8-core AMD Zen 2 CPU, RDNA 2 GPU with 10.28 TFLOPs.',cameraSystem:'Compatible with PS5 HD Camera with dual wide-angle lenses.',batteryAndConnectivity:'Wi-Fi 6, Gigabit Ethernet, Bluetooth 5.1 and USB 3.2.'}}],e.GRADE_EXPLANATIONS={Superb:{title:'Superb',overall:'No functional defects',screenGlass:'Minimal scratches only visible when the screen is off.',display:'Bright sharp panel with no dead pixels or burn-in.',body:'Light cosmetic wear only, with clean edges and camera housing.'},Good:{title:'Good',overall:'Fully functional, thoroughly tested',screenGlass:'Slight micro-scratches that disappear when screen is powered on.',display:'Flawless vibrant panel with accurate touch response.',body:'Minor shallow scuffs on bezel or back glass, no deep cracks or dents.'},Fair:{title:'Fair',overall:'100% operational hardware at best price',screenGlass:'Moderate surface scratches, touch digitizer fully responsive.',display:'Normal brightness, no lines or screen bleeding.',body:'Visible cosmetic wear on edges or casing, casing structural integrity intact.'},'Best Value':{title:'Best Value',overall:'Maximum savings with complete certification',screenGlass:'Visible hairline scratches, zero cracks or chipping.',display:'Crisp display, fully tested touch accuracy across all points.',body:'Noticeable signs of handling, backed by full CTI 1-year warranty.'}},e.REFURBISHED_TESTIMONIALS=[{id:'t-1',name:'Akshy Rao',feedback:'I was not sure before buying a used phone online. But I took the chance as they have return policy and verified certification. The iPhone condition was genuinely superb!'},{id:'t-2',name:'Sophie Turner',feedback:'Great platform with clear product details and fair pricing. The buying experience felt simple and trustworthy. Delivery was fast and doorstep pickup was seamless.'},{id:'t-3',name:'James Walker',feedback:'The whole process was smooth and easy. I found the right device quickly, and everything was exactly as described. Battery health was 98% on my refurbished laptop!'}],e.WHY_SELL_WITH_US=[{id:'w-1',title:'Best Prices',description:'Objective AI-based pricing engine ensuring top market value.',iconType:'tag'},{id:'w-2',title:'Instant Payment',description:'Instant Money Transfer in your preferred mode at time of pick up or store drop off.',iconType:'card'},{id:'w-3',title:'Simple & Convenient',description:'Check price, schedule pickup & get paid in under 24 hours.',iconType:'sparkle'},{id:'w-4',title:'Free Doorstep Pickup',description:'No fees for pickup across 1500+ cities with verified field agents.',iconType:'truck'},{id:'w-5',title:'Factory Grade Data Wipe',description:'100% Safe and Data Security G